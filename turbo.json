{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local", "pnpm-lock.yaml"],
  "globalEnv": [
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "SUPABASE_TABLE_NAME",
    "SPAM_ASSASSIN_HOST",
    "SPAM_ASSASSIN_PORT",
    "PLAYWRIGHT_BROWSERS_PATH"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^postbuild"],
      "outputs": ["dist/**"]
    },
    "postbuild": {
      "dependsOn": ["build"],
      "cache": false
    },
    "web#build": {
      "dependsOn": ["^build", "^postbuild"],
      "env": [
        "RESEND_API_KEY",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "@postcraft/ui#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "playground#build": {
      "dependsOn": ["^build", "^postbuild"],
      "outputs": [".postcraft/**", "!.postcraft/.next/cache/**"]
    },
    "demo#build": {
      "dependsOn": [
        "^build",
        "^postbuild",
        "@postcraft/ui#build",
        "postcraft#build"
      ],
      "outputs": [".postcraft/**", "!.postcraft/.next/cache/**"]
    },
    "postcraft#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {},
    "//#format": {},
    "//#format:check": {},
    "test:e2e": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:watch": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}

